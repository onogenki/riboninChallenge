# 原点を中心とする1mの箱で、Path Boxの初期BOX判定と大きさを合わせます。
mtllib box.mtl
o PathBox
v -0.500000 -0.500000 -0.500000
v 0.500000 -0.500000 -0.500000
v 0.500000 0.500000 -0.500000
v -0.500000 0.500000 -0.500000
v -0.500000 -0.500000 0.500000
v 0.500000 -0.500000 0.500000
v 0.500000 0.500000 0.500000
v -0.500000 0.500000 0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vn 0.000000 0.000000 1.000000
vn 0.000000 0.000000 -1.000000
vn 1.000000 0.000000 0.000000
vn -1.000000 0.000000 0.000000
vn 0.000000 1.000000 0.000000
vn 0.000000 -1.000000 0.000000
usemtl PathBox
s off
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1
f 2/1/2 1/2/2 4/3/2
f 2/1/2 4/3/2 3/4/2
f 6/1/3 2/2/3 3/3/3
f 6/1/3 3/3/3 7/4/3
f 1/1/4 5/2/4 8/3/4
f 1/1/4 8/3/4 4/4/4
f 8/1/5 7/2/5 3/3/5
f 8/1/5 3/3/5 4/4/5
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
